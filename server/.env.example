OPENAI_API_KEY=tu-api-key-de-openai-aqui

# Opcional: si TikTok/Instagram bloquean la descarga con "Unexpected response
# from webpage request", usa cookies de una sesion logueada. Dos formas
# (si defines COOKIES_FILE, tiene prioridad sobre COOKIES_FROM_BROWSER):

# Recomendado en Windows: ruta a un cookies.txt exportado con una extension
# del navegador (ej. "Get cookies.txt LOCALLY"). Evita problemas de cifrado.
# Puede ser un archivo (con uno o varios dominios) o varios archivos separados
# por coma, que se fusionan: COOKIES_FILE=tiktok_cookies.txt,instagram_cookies.txt
# NOTA: para que Instagram devuelva el numero de VISTAS, el cookies.txt de
# instagram.com tiene que incluir la cookie "sessionid" (exportarlo con sesion
# iniciada en instagram.com).
COOKIES_FILE=

# Alternativa: leer directo del navegador (chrome, edge, firefox, brave...).
# Requiere tener el navegador COMPLETAMENTE cerrado al analizar un video.
COOKIES_FROM_BROWSER=

# --- Feature 2: informes de auditoria desde Google Sheets ---
# Ruta al JSON de una cuenta de servicio de Google con la Google Sheets API
# activada. Comparte (lectura) la carpeta de Drive con los sheets de auditoria
# con el email de esa cuenta de servicio. Ver README (Feature 2).
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
